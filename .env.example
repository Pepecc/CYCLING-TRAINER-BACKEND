PORT=3000

# Origen(es) del frontend, separados por comas. Se usa para CORS y para volver tras el OAuth de Wahoo.
# localhost siempre está permitido en CORS.
FRONTEND_URL=http://localhost:5173

DB_PATH=./data/cycling_coach.db

# Zona horaria de los ciclistas: se usa para agrupar entrenos por día y semana
APP_TIMEZONE=Europe/Madrid

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Mensajes por minuto y usuario en el chat (y análisis de entrenos)
CHAT_RATE_LIMIT_PER_MINUTE=10

# Wahoo Cloud API (developers.wahooligan.com)
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
WAHOO_REDIRECT_URI=http://localhost:3000/api/wahoo/callback
WAHOO_SCOPES="email power_zones_read workouts_read plans_read routes_read offline_data user_read"

# Clave para cifrar los tokens de Wahoo en la BD. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No la cambies una vez en uso: los tokens cifrados con la anterior dejarían de poder leerse.
TOKEN_ENCRYPTION_KEY=

# Firebase Admin: JSON completo de la cuenta de servicio en UNA sola línea
# (consola de Firebase > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada)
FIREBASE_SERVICE_ACCOUNT=
